{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/toyonaka-school-lunch.schema.json",
  "title": "豊中市学校給食 月別データ",
  "type": "object",
  "required": [
    "schema_version",
    "year",
    "month",
    "level",
    "block",
    "days"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": 2000
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "level": {
      "type": "string",
      "enum": [
        "elementary_school",
        "middle_school",
        "other"
      ]
    },
    "block": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "weekday",
          "status",
          "menu",
          "beverages"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "weekday": {
            "type": "string",
            "enum": [
              "月",
              "火",
              "水",
              "木",
              "金",
              "土",
              "日"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled",
              "unknown"
            ]
          },
          "menu": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "beverages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
